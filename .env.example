# LocalMuse AI — 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 키를 채우세요. (.env 는 Git에 커밋하지 않음)

# --- NAVER CLOVA Studio ---
# 콘솔에서 발급한 API Key (Authorization: Bearer ...)
CLOVA_API_KEY=
# (레거시) API Gateway Key — 신규 키만 쓰면 비워도 됨
CLOVA_APIGW_API_KEY=
CLOVA_REQUEST_ID=
CLOVA_MODEL=HCX-003
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_MAX_TOKENS=1024
CLOVA_TEMPERATURE=0.5

# --- NAVER Maps (NCP Application) ---
# Geocoding / Reverse Geocoding 헤더:
#   X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 아래 두 개는 위와 동일 키를 쓰는 경우 대체용
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# --- 한국관광공사 TourAPI (data.go.kr) ---
# 일반 인증키 (Decoding 키 권장). 요청 시 자동 unquote 처리.
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService1
TOUR_API_MOBILE_APP=LocalMuseAI
TOUR_API_RETRIES=2

# --- NCP Cloud DB (없으면 로컬 SQLite 사용) ---
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/localmuse
DB_HOST=
DB_PORT=3306
DB_NAME=localmuse
DB_USER=
DB_PASSWORD=
SQLITE_PATH=data/localmuse.sqlite3

# --- App ---
# 위치 권한 거부 시 기본 지역 (PRD: 서울)
DEFAULT_REGION=서울
APP_ENV=development
HTTP_TIMEOUT_SEC=10
# 키가 없을 때 스텁 데이터 허용 (개발용). 운영에서는 false 권장.
ALLOW_STUB_WITHOUT_KEYS=true
