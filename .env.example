# LocalMuse AI — 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 키를 채우세요. (.env 는 Git에 커밋하지 않음)

# --- NAVER CLOVA Studio ---
CLOVA_API_KEY=
CLOVA_APIGW_API_KEY=
CLOVA_REQUEST_ID=

# --- NAVER Maps / Open API ---
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# --- 한국관광공사 TourAPI ---
TOUR_API_KEY=

# --- NCP Cloud DB (MVP) ---
DB_HOST=
DB_PORT=3306
DB_NAME=localmuse
DB_USER=
DB_PASSWORD=

# --- App ---
# 위치 권한 거부 시 기본 지역 (PRD: 서울)
DEFAULT_REGION=서울
APP_ENV=development
