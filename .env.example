# LocalMuse AI — 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 키를 채우세요. (.env 는 Git에 커밋하지 않음)
#
# 검증:
#   python -m BE health --probe
#   python -m BE e2e
#   ./scripts/e2e_seongsu.sh

# --- NAVER CLOVA Studio ---
# NCP 콘솔 > CLOVA Studio > API Key (Authorization: Bearer nv-...)
CLOVA_API_KEY=
# (레거시) API Gateway Key — 신규 키만 쓰면 비워도 됨
CLOVA_APIGW_API_KEY=
CLOVA_REQUEST_ID=
CLOVA_MODEL=HCX-003
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_MAX_TOKENS=1024
CLOVA_TEMPERATURE=0.5

# --- NAVER Maps (NCP AI·NAVER API > Application) ---
# Dynamic Map (JS Marker/Polyline): Client ID 만 필요 → NAVER_MAP_CLIENT_ID
# Geocoding REST: Client ID + Client Secret 필요
# Web 서비스 URL 에 http://localhost:8501 등록 권장
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 동일 앱 키를 쓰는 경우 대체
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# --- 한국관광공사 TourAPI (data.go.kr / api.visitkorea.or.kr) ---
# 국문 관광정보 서비스 KorService2 — Decoding 인증키 권장
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_APP=LocalMuseAI
TOUR_API_RETRIES=2

# --- NCP Cloud DB (없으면 로컬 SQLite) ---
DB_HOST=
DB_PORT=3306
DB_NAME=localmuse
DB_USER=
DB_PASSWORD=
SQLITE_PATH=data/localmuse.sqlite3

# --- App ---
DEFAULT_REGION=서울
APP_ENV=development
HTTP_TIMEOUT_SEC=10
# 키 없을 때 스텁 허용 (개발 true / 운영 false 권장)
ALLOW_STUB_WITHOUT_KEYS=true
